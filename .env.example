# ============================================
# PINOVA PRO — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit actual credentials to version control
# ============================================

# --- Image Search API ---
# Get your key at: https://unsplash.com/developers
# Leave empty to use fallback images (Picsum Photos)
VITE_UNSPLASH_ACCESS_KEY=

# --- OAuth Providers ---
# Google: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# GitHub: https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=

# --- Backend API ---
# URL of the backend server (for full-stack deployment)
VITE_API_URL=http://localhost:3001

# --- SMS Provider (Phone Auth) ---
# Firebase project credentials for phone authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- Backend-only variables (NOT exposed to browser) ---
# These should be set on the server, never in VITE_ prefix
# DATABASE_URL=postgresql://user:pass@localhost:5432/pinova
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=your-super-secret-key
# SESSION_SECRET=your-session-secret
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=pinova-uploads
# AWS_REGION=us-east-1
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
